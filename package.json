    "@types/node": "^22.14.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.3.4",
    "authing-js-sdk": "^4.23.50",
    "autoprefixer": "^10.4.21",
