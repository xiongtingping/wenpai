{
  "name": "wenpai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "build:check": "node scripts/system-sanity-check.mjs && tsc -b && vite build",
    "deploy-check": "node scripts/deploy-check.js && node scripts/system-sanity-check.mjs",
    "predeploy": "npm run deploy-check && npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist",
    "clean": "rm -rf dist node_modules/.vite",
    "type-check": "tsc --noEmit",
    "sync-authing-env": "node sync-authing-env.js",
    "check-authing-config": "node check-authing-config.js",
    "tech-debt:console-strip": "node scripts/strip-console-logs.js strip src",
    "tech-debt:console-verify": "node scripts/strip-console-logs.js verify src",
    "tech-debt:console-restore": "node scripts/strip-console-logs.js restore src",
    "tech-debt:audit": "npm run type-check && npm run lint && npm run tech-debt:console-verify",
    "build:production": "npm run tech-debt:console-strip && npm run build && npm run tech-debt:console-restore",
    "dialog:health-check": "node scripts/dialog-health-check.js",
    "dialog:test": "vitest run src/tests/dialog-positioning.test.ts",
    "dialog:lint": "eslint src --ext ts,tsx --config eslint-rules/dialog-style-rules.js",
    "ui:conflict-check": "node scripts/detect-ui-component-conflicts.js",
    "ui:conflict-fix": "node scripts/detect-ui-component-conflicts.js --fix",
    "dialog:audit": "npm run dialog:health-check && npm run dialog:test && npm run dialog:lint",
    "dialog:fix": "npm run dialog:lint -- --fix",
    "tokens:build": "node tokens/scripts/build.js",
    "style:check": "node scripts/style-system-check.js",
    "style:lint": "stylelint 'src/**/*.{css,scss}' --fix",
    "style:assessment": "node scripts/style-system-assessment.js",
    "style:fix": "npm run style:lint && npm run tokens:build",
    "style:ci": "npm run style:check && npm run style:lint",
    "style:audit": "npm run tokens:build && npm run style:check && npm run style:assessment",
    "perfect:coverage": "node scripts/achieve-100-percent-coverage.js",
    "perfect:compliance": "node scripts/enforce-100-percent-compliance.js",
    "perfect:compliance:fix": "node scripts/enforce-100-percent-compliance.js --fix",
    "perfect:unity": "node scripts/achieve-100-percent-component-unity.js",
    "perfect:unity:fix": "node scripts/achieve-100-percent-component-unity.js --fix",
    "perfect:all": "npm run perfect:coverage && npm run perfect:compliance:fix && npm run perfect:unity:fix",
    "perfect:validate": "npm run perfect:compliance && npm run perfect:unity",
    "css:governance:check": "node scripts/css-governance-enforcer.js check",
    "css:governance:fix": "node scripts/css-governance-enforcer.js fix",
    "css:governance:report": "node scripts/css-governance-enforcer.js report",
    "css:governance:lint": "stylelint 'src/**/*.{css,scss}' --config .stylelintrc.governance.js",
    "css:governance:lint:fix": "stylelint 'src/**/*.{css,scss}' --config .stylelintrc.governance.js --fix",
    "css:governance:audit": "npm run css:governance:check && npm run css:governance:lint",
    "css:governance:enforce": "npm run css:governance:fix && npm run css:governance:lint:fix && npm run css:governance:report",
    "css:governance:batch-fix": "node scripts/css-governance-batch-fix.js",
    "css:governance:emergency-fix": "npm run css:governance:batch-fix && npm run css:governance:check",
    "css:governance:fix-errors": "node scripts/fix-error-level-violations.js",
    "css:governance:complete-fix": "npm run css:governance:fix-errors && npm run css:governance:check",
    "css:governance:smart-check": "node scripts/smart-governance-checker.js",
    "css:governance:comprehensive-fix": "node scripts/comprehensive-violation-fixer.js",
    "css:governance:full-cycle": "npm run css:governance:comprehensive-fix && npm run css:governance:smart-check",
    "css:governance:ultimate-fix": "node scripts/ultimate-violation-eliminator.js",
    "css:governance:complete-cycle": "npm run css:governance:ultimate-fix && node scripts/fix-css-syntax-errors.js && npm run css:governance:smart-check",
    "css:governance:100-percent": "node scripts/ultimate-100-percent-eliminator.js",
    "css:governance:final-100": "npm run css:governance:100-percent && node scripts/fix-css-syntax-errors.js && npm run css:governance:smart-check",
    "css:governance:absolute-zero": "node scripts/absolute-zero-eliminator.js",
    "css:governance:achieve-100": "npm run css:governance:absolute-zero && node scripts/fix-css-syntax-errors.js && npm run css:governance:smart-check",
    "css:governance:comment-cleanup": "node scripts/comment-cleanup-eliminator.js",
    "css:governance:final-zero": "npm run css:governance:comment-cleanup && node scripts/fix-css-syntax-errors.js && npm run css:governance:smart-check",
    "css:governance:size-cleanup": "node scripts/final-hardcoded-size-eliminator.js",
    "css:governance:perfect-100": "npm run css:governance:size-cleanup && node scripts/fix-css-syntax-errors.js && npm run css:governance:smart-check",
    "css:governance:syntax-fix": "node scripts/comprehensive-css-syntax-fixer.js",
    "css:governance:final-build-ready": "npm run css:governance:syntax-fix && npm run css:governance:smart-check && npm run build",
    "css:governance:malformed-fix": "node scripts/malformed-css-property-fixer.js",
    "css:governance:ultimate-build": "npm run css:governance:malformed-fix && npm run css:governance:syntax-fix && npm run css:governance:smart-check && npm run build",
    "css:governance:nested-var-fix": "node scripts/nested-var-fixer.js",
    "css:governance:final-perfect-build": "npm run css:governance:nested-var-fix && npm run css:governance:malformed-fix && npm run css:governance:syntax-fix && npm run build",
    "css:governance:block-close": "node scripts/css-block-closer.js",
    "css:governance:ultimate-perfect-build": "npm run css:governance:block-close && npm run css:governance:nested-var-fix && npm run css:governance:malformed-fix && npm run css:governance:syntax-fix && npm run build",
    "css:governance:tailwind-fix": "node scripts/tailwind-compatibility-fixer.js",
    "css:governance:final-build": "npm run css:governance:tailwind-fix && npm run build",
    "css:governance:classname-fix": "node scripts/duplicate-classname-fixer.js",
    "css:governance:complete-build": "npm run css:governance:classname-fix && npm run css:governance:tailwind-fix && npm run build",
    "css:governance:postcss-fix": "node scripts/postcss-error-fixer.js && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:payment": "jest src/tests/payment-system.test.ts",
    "test:security": "jest src/tests/security-middleware.test.ts",
    "test:integration": "jest src/tests/payment-api-integration.test.ts"
  },
  "dependencies": {
    "@authing/guard-react18": "^5.3.9",
    "@dnd-kit/core": "^6.3.1",
