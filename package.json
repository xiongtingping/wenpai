  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "build:check": "node scripts/system-sanity-check.mjs && tsc -b && vite build",
    "deploy-check": "node scripts/deploy-check.js && node scripts/system-sanity-check.mjs",
    "predeploy": "npm run deploy-check && npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:build": "npm run build && npm run preview",
    "clean": "rm -rf dist node_modules/.vite",
    "type-check": "tsc --noEmit",
    "sync-authing-env": "node sync-authing-env.js",
    "check-authing-config": "node check-authing-config.js"
  },
