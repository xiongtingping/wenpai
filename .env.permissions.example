# =====================================================
# 订阅权限系统环境变量配置模板
# @description 复制此文件为 .env 并填写实际值
# @created 2025-10-02
# =====================================================

# =====================================================
# Supabase 配置
# =====================================================

# Supabase项目URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase匿名密钥 (前端使用)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase服务角色密钥 (后端使用, 绕过RLS)
# ⚠️ 重要: 此密钥拥有完全权限,绝不可暴露到前端!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =====================================================
# 权限系统配置
# =====================================================

# 权限缓存过期时间 (毫秒)
PERMISSION_CACHE_TTL=300000

# 权限缓存最大条目数
PERMISSION_CACHE_MAX_SIZE=200

# 是否启用权限调试日志
PERMISSION_DEBUG=false

# 权限验证密钥 (用于请求签名)
PERMISSION_SECRET=your_random_secret_key_here

# =====================================================
# 定时任务配置
# =====================================================

# Cron任务密钥 (用于验证定时任务调用)
CRON_SECRET=your_cron_secret_here

# 过期检查Cron表达式 (每天凌晨2点执行)
CRON_EXPIRY_CHECK=0 2 * * *

# 自动续费Cron表达式 (每天凌晨3点执行)
CRON_AUTO_RENEW=0 3 * * *

# =====================================================
# 支付配置
# =====================================================

# 支付回调URL
PAYMENT_CALLBACK_URL=https://your-domain.com/api/webhooks/payment-callback

# BufPay配置
BUFPAY_APP_ID=your_bufpay_app_id
BUFPAY_SECRET=your_bufpay_secret
BUFPAY_WEBHOOK_SECRET=your_bufpay_webhook_secret

# 支付宝配置 (如需要)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 微信支付配置 (如需要)
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=

# =====================================================
# 通知配置
# =====================================================

# 邮件服务配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@your-domain.com

# 短信服务配置 (如需要)
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# =====================================================
# 应用配置
# =====================================================

# 应用域名
APP_DOMAIN=your-domain.com

# API基础URL
API_BASE_URL=https://your-domain.com/api

# 前端URL
FRONTEND_URL=https://your-domain.com

# 环境 (development | staging | production)
NODE_ENV=production

# =====================================================
# 安全配置
# =====================================================

# JWT密钥
JWT_SECRET=your_jwt_secret_here

# 会话密钥
SESSION_SECRET=your_session_secret_here

# CORS允许的域名 (逗号分隔)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# =====================================================
# 监控配置
# =====================================================

# Sentry DSN (错误追踪)
SENTRY_DSN=

# Google Analytics ID
GA_TRACKING_ID=

# =====================================================
# 功能开关
# =====================================================

# 是否启用自动续费
ENABLE_AUTO_RENEW=true

# 是否启用限时优惠
ENABLE_LIMITED_DISCOUNT=true

# 限时优惠时长 (分钟)
LIMITED_DISCOUNT_DURATION=30

# 是否启用试用期
ENABLE_TRIAL_PERIOD=true

# 试用期时长 (天)
TRIAL_PERIOD_DAYS=30

# =====================================================
# 开发环境配置 (仅开发时使用)
# =====================================================

# 是否启用调试模式
DEBUG=false

# 是否启用模拟支付 (跳过真实支付)
MOCK_PAYMENT=false

# 是否启用测试用户
ENABLE_TEST_USERS=true

# =====================================================
# 注意事项
# =====================================================
# 1. 将此文件复制为 .env
# 2. 填写所有带有 your_* 前缀的值
# 3. 确保 .env 已添加到 .gitignore
# 4. 生产环境必须使用强随机密钥
# 5. 定期轮换密钥以提高安全性
# =====================================================
