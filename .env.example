# 🔐 AI API统一管理 - 环境变量配置示例
# 
# 🎯 目标：消除硬编码，统一管理所有API配置
# 📌 规则：所有敏感信息必须通过环境变量配置
# 
# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 填入真实的API密钥和配置
# 3. 确保 .env.local 已添加到 .gitignore

# ===== 🤖 AI服务API密钥配置 =====

# 🔧 AIMLAPI配置（统一AI接入服务 - 主要配置）
# 支持: OpenAI/Claude/Gemini/Meta等多种模型
VITE_AIMLAPI_KEY=your_aimlapi_key_here
VITE_AIMLAPI_BASE_URL=https://api.aimlapi.com

# 🔧 DeepSeek API配置（独立直连 - 可选配置）
# 用于DeepSeek模型的直接调用，可选配置
VITE_DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 📌 重要说明 =====
# 1. 除了DeepSeek外，所有AI模型（OpenAI/Claude/Gemini等）统一通过AIMLAPI调用
# 2. VITE_AIMLAPI_KEY 是必需配置项，系统主要依赖此密钥
# 3. VITE_DEEPSEEK_API_KEY 是可选配置，未配置时DeepSeek模型不可用
# 4. 不再需要单独配置OpenAI/Claude/Gemini的API密钥

# ===================
# 🔐 认证配置
# ===================
# Authing 配置
VITE_AUTHING_APP_ID=your-authing-app-id
VITE_AUTHING_APP_HOST=https://your-domain.authing.cn

# ===================
# 🗄️ 数据库配置
# ===================
