# 环境变量示例文件
# 请复制此文件为 .env.local 并填入您的真实配置

# ===================
# 🔒 安全说明
# ===================
# 1. API 密钥已移至服务端，客户端不再需要配置
# 2. 此文件仅包含非敏感的配置示例
# 3. 请勿在此文件中填入真实的密钥信息

# ===================
# 🌐 API 端点配置
# ===================
# OpenAI API 配置
VITE_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
VITE_OPENAI_MODEL=gpt-4o
VITE_OPENAI_TIMEOUT=30000

# DeepSeek API 配置
VITE_DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_TIMEOUT=30000

# Google Gemini API 配置
VITE_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent
VITE_GEMINI_MODEL=gemini-pro
VITE_GEMINI_TIMEOUT=30000

# ===================
# 🔐 认证配置
# ===================
# Authing 配置
VITE_AUTHING_APP_ID=your-authing-app-id
VITE_AUTHING_APP_HOST=https://your-domain.authing.cn

# ===================
# 🗄️ 数据库配置
# ===================
# Supabase 配置
VITE_SUPABASE_URL=https://weizkydylskcwgnaieqy.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndlaXpreWR5bHNrY3dnbmFpZXF5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTUwNTIzMzksImV4cCI6MjA3MDYyODMzOX0.77cefG7i52iWjR6D_0H1aB-xmmJe19WQlM8PkGISW7c

# Supabase Service Role Key (用于数据库初始化，可选)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndlaXpreWR5bHNrY3dnbmFpZXF5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NTA1MjMzOSwiZXhwIjoyMDcwNjI4MzM5fQ.l5BvkhJttv0agpydb5lktK1Q4KvDaxQTNUb5-GMU14w

# ===================
# 🌐 API 基础配置
# ===================
VITE_API_BASE_URL=https://your-api-domain.com/api
VITE_API_TIMEOUT=30000
VITE_MAX_RETRIES=3

# ===================
# 🔧 功能开关
# ===================
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_IMAGE_GENERATION=true
VITE_ENABLE_CONTENT_ADAPTATION=true

# ===================
# 📡 RSSHub 配置
# ===================
# RSSHub API 端点
VITE_RSSHUB_API_URL=https://rsshub.app
VITE_RSSHUB_ACCESS_KEY=
VITE_RSSHUB_TIMEOUT=10000

# 数据融合配置
VITE_DATA_FUSION_ENABLE_RSSHUB=true
VITE_DATA_FUSION_ENABLE_DAILYHOT=true
VITE_DATA_FUSION_STRATEGY=merge
VITE_DATA_FUSION_DEDUP_THRESHOLD=0.8
VITE_DATA_FUSION_MAX_TOPICS=200

# 缓存配置
VITE_CACHE_DURATION=300000
VITE_CACHE_MAX_SIZE=1000

# 热点数据配置
VITE_HOT_TOPICS_REFRESH_INTERVAL=300000
VITE_HOT_TOPICS_MAX_ITEMS=100
VITE_HOT_TOPICS_ENABLE_AUTO_REFRESH=true

# ===================
# 🐛 调试配置
# ===================
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# ===================
# 🔒 安全配置
# ===================
VITE_ENCRYPTION_KEY=your-custom-encryption-key-32-chars-long
VITE_SECURITY_LEVEL=high
VITE_ENABLE_SECURITY_LOGGING=true

# ===================
# 💳 支付配置（可选）
# ===================
VITE_ALIPAY_APP_ID=your-alipay-app-id
VITE_WECHAT_APP_ID=your-wechat-app-id

# ===================
# 🌐 部署配置
# ===================
# 基础路径（用于子路径部署）
VITE_BASE_PATH=/
# 前端域名
FRONTEND_URL=https://your-domain.com
# 后端端口（开发环境）
BACKEND_PORT=3001

# ===================
# 📝 使用说明
# ===================
# 1. 复制此文件为 .env.local
# 2. 填入您的真实配置值
# 3. 确保 .env.local 已添加到 .gitignore
# 4. API 密钥请在服务端配置，不要在客户端暴露
