/**
 * Dialog背景遮罩层强制铺满视口修复
 * 🎯 确保背景遮罩层完全覆盖整个浏览器视口
 */

/* 🚨 最高优先级选择器 - 强制背景遮罩铺满视口 */
.dialog-overlay-fullscreen,
[data-radix-dialog-overlay],
div[data-state="open"][class*="dialog-overlay"],
div[data-state="open"][class*="backdrop-blur"],
div[data-state="open"][class*="bg-foreground"],
div[data-state="open"].fixed.inset-0,
body div[data-state="open"][class*="fixed"][class*="inset-0"],
/* 🔥 超强选择器 - 针对所有可能的背景遮罩元素 */
html div[data-state="open"][class*="fixed"],
body div[data-state="open"][class*="fixed"],
#root div[data-state="open"][class*="fixed"],
div[data-radix-portal] div[data-state="open"][class*="fixed"],
[data-radix-portal] > div[data-state="open"],
body > div[data-radix-portal] > div[data-state="open"] {
  /* 🚨 强制定位和尺寸 - 最高优先级 */
  position: fixed !important;
  top: 0px !important;
  left: 0px !important;
  right: 0px !important;
  bottom: 0px !important;
  width: 100vw !important;
  height: 100vh !important;
  min-width: 100vw !important;
  min-height: 100vh !important;
  max-width: 100vw !important;
  max-height: 100vh !important;
  
  /* 🚨 强制层级 */
  z-index: 1045 !important;
  
  /* 🚨 重置可能影响定位的属性 */
  transform: none !important;
  translate: none !important;
  contain: none !important;
  isolation: auto !important;
  clip-path: none !important;
  filter: none !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  outline: none !important;
  
  /* 🚨 强制可见性 */
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}

/* 🚨 特殊情况：针对可能的inset属性冲突 */
.dialog-overlay-fullscreen,
[data-radix-dialog-overlay] {
  inset: 0 !important;
  inset-block: 0 !important;
  inset-inline: 0 !important;
  inset-block-start: 0 !important;
  inset-block-end: 0 !important;
  inset-inline-start: 0 !important;
  inset-inline-end: 0 !important;
}

/* 🚨 确保在任何情况下都能铺满视口 */
html .dialog-overlay-fullscreen,
body .dialog-overlay-fullscreen,
#root .dialog-overlay-fullscreen {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
}

/* 🔥 终极修复 - 针对底部空隙问题 */
div[data-state="open"][class*="fixed"],
div[data-state="open"][class*="bg-foreground"],
div[data-state="open"][class*="backdrop-blur"] {
  /* 🚨 强制覆盖所有可能的底部间距 */
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
  border-bottom: none !important;
  
  /* 🚨 确保底部完全贴合 */
  bottom: 0px !important;
  height: 100vh !important;
  min-height: 100vh !important;
  max-height: none !important;
  
  /* 🚨 重置所有可能影响底部的CSS属性 */
  contain: none !important;
  isolation: auto !important;
  transform: none !important;
  translate: none !important;
  clip: none !important;
  clip-path: none !important;
  overflow: visible !important;
  
  /* 🚨 强制box-sizing为border-box */
  box-sizing: border-box !important;
}

/* 🔥 超级强制修复 - 直接针对背景遮罩的属性值 */
body div[data-aria-hidden="true"][data-state="open"] {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* 🎯 精确匹配我们的背景遮罩类 */
.dialog-background-overlay,
.dialog-overlay-fullscreen.dialog-background-overlay {
  /* 🚨 终极底部修复 */
  position: fixed !important;
  top: 0px !important;
  left: 0px !important;
  right: 0px !important;
  bottom: 0px !important;
  width: 100vw !important;
  height: 100vh !important;
  min-height: 100vh !important;
  max-height: 100vh !important;
  
  /* 🚨 完全重置所有可能影响底部的属性 */
  margin: 0px !important;
  padding: 0px !important;
  border: 0px !important;
  outline: 0px !important;
  transform: none !important;
  translate: none !important;
  scale: none !important;
  rotate: none !important;
  
  /* 🚨 确保box model正确 */
  box-sizing: border-box !important;
  overflow: hidden !important;
}