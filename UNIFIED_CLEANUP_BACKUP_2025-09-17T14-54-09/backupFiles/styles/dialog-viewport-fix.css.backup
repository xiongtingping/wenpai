/**
 * 🚨 Dialog视窗定位紧急修复
 * 
 * 问题确诊：Dialog被定位到 top: 2678px，远超视窗范围
 * 根本原因：50% 相对于页面高度计算，而不是视窗高度
 * 解决方案：强制使用视窗单位和绝对像素定位
 */

/* ========================================
   🚨 强制视窗居中 - 最高优先级
   ======================================== */

[role="dialog"].quick-reference-dialog,
[role="dialog"][class*="quick-reference"],
.quick-reference-dialog[role="dialog"],
[role="dialog"][id*="quick-reference"] {
  /* 🚨 强制使用视窗坐标系 - 增加上边距避免顶部紧贴 */
  position: fixed !important;
  top: calc(50vh - 20px) !important;      /* 🔥 视窗高度50% - 20px上边距 */
  left: 50vw !important;                  /* 🔥 视窗宽度50% */
  transform: translate(-50%, -50%) !important;
  
  /* 🚨 彻底清除可能的百分比定位 */
  inset: unset !important;
  inset-block: unset !important;
  inset-inline: unset !important;
  inset-block-start: unset !important;
  inset-block-end: unset !important;
  inset-inline-start: unset !important;
  inset-inline-end: unset !important;
  
  /* 🚨 重置margin和padding避免偏移 */
  margin: 0 !important;
  margin-top: 0 !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  margin-bottom: 0 !important;
  
  /* 🚨 强制可见性 */
  display: flex !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  z-index: 999999 !important;
  
  /* 🚨 调试样式 */
  background: #ffffff !important;
  border: 5px solid #ff0000 !important;
  border-radius: 8px !important;
  box-shadow: 0 0 50px rgba(255, 0, 0, 1) !important;
  
  /* 🚨 尺寸限制 */
  max-width: 90vw !important;
  max-height: 80vh !important;
  min-width: 400px !important;
  min-height: 300px !important;
  width: auto !important;
  height: auto !important;
  
  /* 🚨 内容样式 */
  padding: 20px !important;
  color: #000000 !important;
  font-size: 14px !important;
  
  /* 🚨 清除所有可能的定位干扰 */
  contain: none !important;
  isolation: auto !important;
  clip-path: none !important;
  mask: none !important;
  filter: none !important;
  overflow: visible !important;
  
  /* 🚨 清除transform相关属性 */
  translate: none !important;
  rotate: none !important;
  scale: none !important;
  
  /* 🚨 清除动画 */
  animation: none !important;
  transition: none !important;
}

/* ========================================
   🚨 强制视窗居中 - 内联样式级别
   ======================================== */

/* 针对有内联样式的Dialog元素 */
[role="dialog"][style] {
  position: fixed !important;
  top: 50vh !important;
  left: 50vw !important;
  transform: translate(-50%, -50%) !important;
}

/* ========================================
   🚨 特殊处理 - 快速引用Dialog
   ======================================== */

[role="dialog"].quick-reference-dialog,
[role="dialog"][class*="quick-reference"],
.quick-reference-dialog[role="dialog"] {
  /* 🚨 确保视窗居中 */
  position: fixed !important;
  top: 50vh !important;
  left: 50vw !important;
  transform: translate(-50%, -50%) !important;
  
  /* 🚨 更明显的调试标识 */
  border: 10px solid #ff0000 !important;
  box-shadow: 
    0 0 30px rgba(255, 0, 0, 0.8),
    inset 0 0 30px rgba(255, 0, 0, 0.3) !important;
}

/* ========================================
   🚨 调试信息 - 位置验证
   ======================================== */

[role="dialog"].quick-reference-dialog::before,
[role="dialog"][class*="quick-reference"]::before {
  content: "🚨 VIEWPORT CENTER: " attr(data-debug-position) !important;
  position: absolute !important;
  top: -50px !important;
  left: 0 !important;
  background: #ff0000 !important;
  color: #ffffff !important;
  padding: 8px 12px !important;
  font-size: 12px !important;
  font-weight: bold !important;
  border-radius: 4px !important;
  z-index: 999999 !important;
  white-space: nowrap !important;
}

/* ========================================
   🚨 移动端适配
   ======================================== */

@media (max-width: 640px) {
  [role="dialog"].quick-reference-dialog,
  [role="dialog"][class*="quick-reference"],
  .quick-reference-dialog[role="dialog"],
  [role="dialog"][id*="quick-reference"] {
    /* 🚨 移动端也使用视窗单位 - 增加上边距 */
    top: calc(50vh - 10px) !important;
    left: 50vw !important;
    transform: translate(-50%, -50%) !important;
    max-width: 95vw !important;
    max-height: 90vh !important;
    min-width: 280px !important;
    padding: 16px !important;
  }
}

/* ========================================
   🚨 强制重绘触发
   ======================================== */

[role="dialog"].quick-reference-dialog,
[role="dialog"][class*="quick-reference"] {
  will-change: transform, top, left !important;
  backface-visibility: hidden !important;
}