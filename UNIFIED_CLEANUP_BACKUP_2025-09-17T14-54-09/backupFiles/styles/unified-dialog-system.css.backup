/*
 * 统一Dialog样式系统
 * 基于设计令牌的Dialog组件样式，确保定位问题不再复发
 */

@layer components {
  /* 🎯 统一Dialog基础样式 - 使用设计令牌 */
  .unified-dialog {
    /* 强制定位 - 使用设计令牌确保一致性 */
    position: var(--dialog-position-strategy) !important;
    top: var(--dialog-center-y) !important;
    left: var(--dialog-center-x) !important;
    transform: var(--dialog-transform) !important;
    z-index: var(--dialog-z-index) !important;
    
    /* 重置可能冲突的属性 */
    margin: 0 !important;
    inset: auto !important;
    translate: none !important;
    rotate: none !important;
    scale: none !important;
    
    /* 基础样式 */
    display: flex;
    flex-direction: column;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-dialog);
    
    /* 确保可见性 */
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    
    /* 防止内容溢出 */
    overflow: hidden;
    max-width: calc(100vw - var(--spacing-8));
    max-height: calc(100vh - var(--spacing-8));
  }

  /* 🎯 统一Dialog Overlay样式 */
  .unified-dialog-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    z-index: var(--dialog-overlay-z-index) !important;
    
    background: hsl(var(--foreground) / 0.5);
    backdrop-filter: blur(var(--spacing-1));
    
    /* 确保覆盖整个视口 */
    width: 100vw !important;
    height: 100vh !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* 🎯 Dialog尺寸变体 */
  .unified-dialog--small {
    min-width: var(--dialog-size-small-width);
    min-height: var(--dialog-size-small-height);
    max-width: min(95vw, 400px);
    max-height: min(85vh, 300px);
  }

  .unified-dialog--medium {
    min-width: var(--dialog-size-medium-width);
    min-height: var(--dialog-size-medium-height);
    max-width: min(95vw, 600px);
    max-height: min(85vh, 500px);
  }

  .unified-dialog--large {
    min-width: var(--dialog-size-large-width);
    min-height: var(--dialog-size-large-height);
    max-width: min(95vw, 1024px);
    max-height: min(85vh, 700px);
  }

  .unified-dialog--fullscreen {
    min-width: var(--dialog-size-fullscreen-width);
    min-height: var(--dialog-size-fullscreen-height);
    max-width: var(--dialog-size-fullscreen-width);
    max-height: var(--dialog-size-fullscreen-height);
  }

  /* 🎯 Dialog样式变体 */
  .unified-dialog--elevated {
    box-shadow: var(--shadow-dialog), var(--shadow-dialog-overlay);
    border-radius: var(--radius-xl);
  }

  .unified-dialog--minimal {
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  /* 🎯 Dialog动画状态 */
  .unified-dialog[data-state="open"] {
    animation: var(--animation-dialog-enter);
  }

  .unified-dialog[data-state="closed"] {
    animation: var(--animation-dialog-exit);
  }

  .unified-dialog-overlay[data-state="open"] {
    animation: var(--animation-overlay-enter);
  }

  .unified-dialog-overlay[data-state="closed"] {
    animation: var(--animation-overlay-exit);
  }

  /* 🎯 Dialog内容区域 */
  .unified-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  .unified-dialog__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-foreground);
    margin: 0;
  }

  .unified-dialog__description {
    font-size: var(--font-size-sm);
    color: var(--color-muted-foreground);
    margin: var(--spacing-xs) 0 0;
  }

  .unified-dialog__content {
    flex: 1;
    padding: var(--spacing-lg);
    overflow-y: auto;
  }

  .unified-dialog__footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg);
    border-top: 1px solid var(--color-border);
  }

  .unified-dialog__close {
    position: absolute;
    top: var(--spacing-md);
    right: var(--spacing-md);
    width: var(--spacing-6);
    height: var(--spacing-6);
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--color-muted-foreground);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .unified-dialog__close:hover {
    background: var(--color-muted);
    color: var(--color-foreground);
  }

  .unified-dialog__close:focus-visible {
    outline: var(--spacing-0-5) solid var(--color-ring);
    outline-offset: var(--spacing-0-5);
  }
}

/* 🎯 兼容性修复 - 确保覆盖可能冲突的样式 */
@layer utilities {
  /* 强制覆盖任何可能的定位冲突 */
  .unified-dialog-force-center {
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 50 !important;
    margin: 0 !important;
    inset: auto !important;
  }

  /* 强制覆盖任何可能的Overlay冲突 */
  .unified-dialog-overlay-force {
    position: fixed !important;
    inset: 0 !important;
    z-index: 40 !important;
    width: 100vw !important;
    height: 100vh !important;
    margin: 0 !important;
    padding: 0 !important;
  }
}

/* 🎯 响应式适配 */
@media (max-width: 640px) {
  .unified-dialog {
    max-width: calc(100vw - var(--spacing-4)) !important;
    max-height: calc(100vh - var(--spacing-4)) !important;
    margin: var(--spacing-2) !important;
  }

  .unified-dialog--fullscreen {
    max-width: 100vw !important;
    max-height: 100vh !important;
    margin: 0 !important;
    border-radius: var(--radius-none) !important;
  }
}

/* 🎯 主题适配 */
[data-theme="dark"] .unified-dialog {
  box-shadow: 0 25px 50px -var(--spacing-3) hsl(var(--foreground) / 0.5);
}

[data-theme="light"] .unified-dialog {
  box-shadow: 0 25px 50px -var(--spacing-3) rgba(0, 0, 0, 0.15);
}

/* 🎯 无障碍支持 */
@media (prefers-reduced-motion: reduce) {
  .unified-dialog,
  .unified-dialog-overlay {
    animation: none !important;
    transition: none !important;
  }
}
