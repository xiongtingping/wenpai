/**
 * 🎯 快速引用Dialog专项修复 - 精确定向，不影响其他Dialog
 * 
 * 策略：仅针对快速引用Dialog进行修复，避免影响历史记录等其他Dialog
 * 
 * 🚨 根本问题：Dialog内容容器不可见
 * 解决方案：多重选择器覆盖，确保Dialog内容容器被正确显示
 */

/* ========================================
   🎯 多重选择器 - 覆盖所有可能的Dialog内容容器
   ======================================== */

/* 🎯 第一层：基础Dialog选择器 */
[role="dialog"].quick-reference-dialog,
[data-radix-dialog-content].quick-reference-dialog,
[class*="quick-reference-dialog"][role="dialog"],
[class*="quick-reference-dialog"][data-radix-dialog-content],

/* 🎯 第二层：Portal内的Dialog选择器 */
[data-radix-portal] [role="dialog"].quick-reference-dialog,
[data-radix-portal] [data-radix-dialog-content].quick-reference-dialog,
[data-radix-portal] [class*="quick-reference-dialog"][role="dialog"],
[data-radix-portal] [class*="quick-reference-dialog"][data-radix-dialog-content],

/* 🎯 第三层：深层Portal选择器 */
html [data-radix-portal] [role="dialog"],
body [data-radix-portal] [role="dialog"],
div[data-radix-portal] [role="dialog"],
html [data-radix-portal] [data-radix-dialog-content],
body [data-radix-portal] [data-radix-dialog-content],
div[data-radix-portal] [data-radix-dialog-content],

/* 🎯 第四层：通用Dialog容器（仅在快速引用Dialog存在时生效） */
body:has(.quick-reference-dialog) [role="dialog"],
body:has(.quick-reference-dialog) [data-radix-dialog-content] {
  /* 🚨 强制居中定位 */
  position: fixed !important;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  
  /* 🚨 清除可能的干扰属性 */
  right: auto !important;
  bottom: auto !important;
  inset: auto !important;
  margin: 0 !important;
  translate: none !important;
  
  /* 🚨 合理的尺寸设置 */
  max-width: min(95vw, 1024px) !important;
  max-height: 85vh !important;
  width: auto !important;
  height: auto !important;
  min-width: 320px !important;
  min-height: 200px !important;
  
  /* 🚨 强制可见性 - 超高优先级 */
  display: flex !important;
  flex-direction: column !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  z-index: 999999 !important; /* 🚨 超高z-index确保显示在最顶层 */
  
  /* 🚨 强制覆盖可能的隐藏样式 */
  clip: none !important;
  clip-path: none !important;
  mask: none !important;
  mask-image: none !important;
  overflow: visible !important;
  
  /* 🚨 紧急调试样式 - 强制可见 */
  background: white !important;
  border: 3px solid red !important; /* 🚨 红色边框用于调试 */
  border-radius: var(--spacing-2) !important;
  box-shadow: 0 0 30px rgba(255, 0, 0, 0.8) !important; /* 🚨 红色阴影用于调试 */
  color: black !important;
  
  /* 🚨 强制最基本的显示属性 */
  min-width: 400px !important;
  min-height: 300px !important;
  padding: var(--spacing-5) !important;
  
  /* 🚨 重置可能影响定位的属性 */
  contain: none !important;
  isolation: auto !important;
  clip-path: none !important;
  filter: none !important;
  will-change: transform, opacity !important;
  backface-visibility: hidden !important;
}

/* ========================================
   🎯 快速引用Dialog背景遮罩修复
   ======================================== */

/* 仅在快速引用Dialog打开时修复背景遮罩 */
body:has([role="dialog"].quick-reference-dialog) [data-radix-dialog-overlay],
body:has([data-radix-dialog-content].quick-reference-dialog) [data-radix-dialog-overlay] {
  position: fixed !important;
  inset: 0 !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  z-index: 1050 !important;
  background-color: hsl(var(--background) / 0.8) !important;
  backdrop-filter: blur(var(--spacing-1)) !important;
  opacity: 1 !important;
  visibility: visible !important;
  display: block !important;
}

/* ========================================
   🎯 移除动画干扰 - 仅快速引用Dialog
   ======================================== */

[role="dialog"].quick-reference-dialog[data-state],
[data-radix-dialog-content].quick-reference-dialog[data-state] {
  animation: none !important;
  transition: opacity 0.2s ease-out !important;
  transform: translate(-50%, -50%) !important;
}

/* ========================================
   🎯 响应式适配 - 仅快速引用Dialog
   ======================================== */

@media (max-width: 640px) {
  [role="dialog"].quick-reference-dialog,
  [data-radix-dialog-content].quick-reference-dialog {
    max-width: calc(100vw - var(--spacing-4)) !important;
    max-height: calc(100vh - var(--spacing-4)) !important;
    min-width: 280px !important;
    padding: var(--spacing-4) !important;
  }
}

/* ========================================
   🎯 调试模式 - 仅快速引用Dialog
   ======================================== */

/* 当需要调试时可以启用 */
.debug-quick-reference [role="dialog"].quick-reference-dialog,
.debug-quick-reference [data-radix-dialog-content].quick-reference-dialog {
  border: var(--spacing-0-5) dashed lime !important;
  box-shadow: 0 0 var(--spacing-2-5) rgba(0, 255, 0, 0.5) !important;
}

.debug-quick-reference [role="dialog"].quick-reference-dialog::before,
.debug-quick-reference [data-radix-dialog-content].quick-reference-dialog::before {
  content: "🎯 快速引用Dialog - 精确修复";
  position: absolute;
  top: -25px;
  left: 0;
  background: lime;
  color: black;
  padding: var(--spacing-0-5) var(--spacing-1-5);
  font-size: 11px;
  font-weight: bold;
  border-radius: 3px;
  z-index: 999999;
  white-space: nowrap;
}

/* ========================================
   🚨 终极强制修复 - 如果以上都失效
   ======================================== */

/* 🚨 暴力修复：直接针对所有Portal内的Dialog */
[data-radix-portal] > div {
  /* 🚨 强制显示所有Portal内的直接子元素 */
  display: flex !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  z-index: 999998 !important;
  position: fixed !important;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  
  /* 🚨 调试样式 */
  background: yellow !important;
  border: var(--spacing-0-5) dashed blue !important;
  min-width: 300px !important;
  min-height: 200px !important;
  padding: var(--spacing-2-5) !important;
}

/* 🚨 更加暴力的修复：针对所有可能的Dialog相关元素 */
div[data-state="open"] + div,
div[data-state="open"] ~ div,
div[aria-hidden="false"],
div[role="dialog"],
div[data-radix-dialog-content] {
  display: flex !important;
  visibility: visible !important;
  opacity: 1 !important;
  z-index: 999997 !important;
  position: fixed !important;
  top: 40% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  background: lightblue !important;
  border: var(--spacing-0-5) solid orange !important;
  min-width: 350px !important;
  min-height: 250px !important;
  padding: 15px !important;
}