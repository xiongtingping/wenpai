/**
 * 🚨 快速引用弹窗可见性紧急修复CSS
 * 
 * 问题：弹窗看不到，背景层是白色的
 * 目标：强制弹窗可见并正确居中
 * 策略：使用明显的调试样式确保弹窗可见
 */

/* ========================================
   🚨 紧急可见性修复 - 最高优先级
   ======================================== */

/* 🎯 快速引用弹窗专用选择器 - 明显可见 */
[role="dialog"].quick-reference-dialog,
[role="dialog"][class*="quick-reference"],
.quick-reference-dialog[role="dialog"],
[data-radix-dialog-content].quick-reference-dialog,
[data-radix-portal] [role="dialog"],
body [data-radix-portal] [role="dialog"] {
  /* 🚨 强制定位居中 */
  position: fixed !important;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  
  /* 🚨 完全重置可能隐藏弹窗的属性 */
  inset: auto !important;
  margin: 0 !important;
  
  /* 🚨 强制可见性 */
  display: flex !important;
  flex-direction: column !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  z-index: 999999 !important;
  
  /* 🚨 明显的调试样式 - 确保可见 */
  background: #ffffff !important;
  border: 3px solid #ff0000 !important; /* 红色边框便于识别 */
  border-radius: 12px !important;
  box-shadow: 0 0 20px rgba(255, 0, 0, 0.5) !important; /* 红色阴影 */
  
  /* 🚨 尺寸设置 */
  max-width: min(90vw, 800px) !important;
  max-height: 80vh !important;
  min-width: 400px !important;
  min-height: 300px !important;
  width: auto !important;
  height: auto !important;
  
  /* 🚨 内容样式 */
  padding: 24px !important;
  overflow: visible !important;
  
  /* 🚨 重置所有可能影响显示的属性 */
  clip-path: none !important;
  filter: none !important;
  contain: none !important;
  isolation: auto !important;
  mask: none !important;
  
  /* 🚨 文字颜色确保可见 */
  color: #000000 !important;
}

/* 🚨 强制显示调试标签 */
[role="dialog"].quick-reference-dialog::before,
[role="dialog"][class*="quick-reference"]::before,
.quick-reference-dialog[role="dialog"]::before {
  content: "🚨 DIALOG VISIBLE - 调试模式" !important;
  position: absolute !important;
  top: -40px !important;
  left: 0 !important;
  background: #ff0000 !important;
  color: #ffffff !important;
  padding: 8px 12px !important;
  font-size: 14px !important;
  font-weight: bold !important;
  border-radius: 4px !important;
  z-index: 999999 !important;
  white-space: nowrap !important;
}

/* ========================================
   🚨 背景遮罩修复
   ======================================== */

/* 确保背景遮罩可见且正确 */
[data-radix-dialog-overlay],
.dialog-overlay {
  position: fixed !important;
  inset: 0 !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  z-index: 999998 !important;
  
  /* 🚨 明显的背景颜色 - 半透明红色便于识别 */
  background-color: rgba(255, 0, 0, 0.3) !important;
  backdrop-filter: blur(2px) !important;
  
  /* 🚨 确保可见 */
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}

/* ========================================
   🚨 强制覆盖所有可能隐藏的样式
   ======================================== */

/* 移除可能的隐藏类 */
[role="dialog"][class*="hidden"],
[role="dialog"][class*="invisible"],
[data-radix-dialog-content][class*="hidden"],
[data-radix-dialog-content][class*="invisible"] {
  display: flex !important;
  visibility: visible !important;
  opacity: 1 !important;
}

/* 强制移除transform scale(0)等隐藏效果 */
[role="dialog"][style*="scale(0)"],
[role="dialog"][style*="opacity: 0"],
[data-radix-dialog-content][style*="scale(0)"],
[data-radix-dialog-content][style*="opacity: 0"] {
  transform: translate(-50%, -50%) scale(1) !important;
  opacity: 1 !important;
}

/* ========================================
   🚨 响应式调试
   ======================================== */

/* 移动端调试 */
@media (max-width: 640px) {
  [role="dialog"].quick-reference-dialog,
  [role="dialog"][class*="quick-reference"] {
    max-width: calc(95vw - 20px) !important;
    max-height: calc(90vh - 20px) !important;
    min-width: 280px !important;
    padding: 16px !important;
    
    /* 确保在移动端也居中 */
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
  }
}

/* ========================================
   🚨 内容区域强制可见
   ======================================== */

/* 确保Dialog内容可见 */
[role="dialog"] * {
  color: inherit !important;
  background: inherit !important;
}

/* 强制显示所有子元素 */
[role="dialog"] > *,
[data-radix-dialog-content] > * {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
}

/* 确保flex容器正常显示 */
[role="dialog"] .flex,
[role="dialog"] [class*="flex"] {
  display: flex !important;
}