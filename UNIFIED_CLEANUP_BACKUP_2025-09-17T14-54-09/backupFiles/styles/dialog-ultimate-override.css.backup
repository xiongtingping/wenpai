/**
 * 🚨 Dialog终极覆盖CSS - 解决多重CSS冲突问题
 * 
 * 问题分析：发现有大量CSS文件在操作[role="dialog"]选择器，
 * 导致样式冲突，快速引用Dialog被隐藏或定位错误
 * 
 * 解决方案：使用超高优先级选择器，强制覆盖所有冲突样式
 * 优先级：html body * > body * > html * > *
 */

/* ========================================
   🚨 超级高优先级选择器
   ======================================== */

/* 🎯 快速引用Dialog专用终极修复 - 限制选择器范围 */
[role="dialog"].quick-reference-dialog,
[role="dialog"][class*="quick-reference"],
.quick-reference-dialog[role="dialog"],
[role="dialog"]:has([class*="quick-reference"]) {
  /* 🚨 强制可见性 - 覆盖所有可能的隐藏 */
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  
  /* 🚨 强制定位 - 向下偏移确保上边距 */
  position: fixed !important;
  top: calc(50vh + 40px) !important;  /* 🔥 关键修复：向下偏移40px */
  left: 50vw !important;
  transform: translate(-50%, -50%) !important;
  z-index: 999999 !important;
  
  /* 🚨 清除所有可能的隐藏属性 */
  clip-path: none !important;
  mask: none !important;
  filter: none !important;
  contain: none !important;
  overflow: visible !important;
  
  /* 🚨 重置尺寸和边距 */
  margin: 0 !important;
  padding: 20px !important;
  border: 3px solid #ff0000 !important;
  border-radius: 8px !important;
  background: #ffffff !important;
  box-shadow: 0 0 30px rgba(255, 0, 0, 0.8) !important;
  
  /* 🚨 确保有实际尺寸 - 增加宽度 */
  min-width: 600px !important;        /* 🔥 从400px增加到600px */
  min-height: 300px !important;
  max-width: min(95vw, 1200px) !important;  /* 🔥 从90vw增加到95vw，并设置最大1200px */
  max-height: 80vh !important;
  width: auto !important;
  height: auto !important;
  
  /* 🚨 重置所有可能的动画和变换 */
  animation: none !important;
  transition: none !important;
  translate: none !important;
  rotate: none !important;
  scale: none !important;
  
  /* 🚨 重置inset - 避免定位冲突 */
  inset: auto !important;
  inset-block: auto !important;
  inset-inline: auto !important;
  inset-block-start: auto !important;
  inset-block-end: auto !important;
  inset-inline-start: auto !important;
  inset-inline-end: auto !important;
  
  /* 🚨 确保文字可见 */
  color: #000000 !important;
  font-size: 14px !important;
}

/* ========================================
   🚨 Portal容器修复
   ======================================== */

/* 确保Portal容器不会隐藏Dialog - 仅针对快速引用相关 */
[data-radix-portal]:has([role="dialog"].quick-reference-dialog),
[data-radix-portal]:has([class*="quick-reference"]),
#dialog-portal-root {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  pointer-events: auto !important;
  z-index: 999998 !important;
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  background: transparent !important;
  overflow: visible !important;
  contain: none !important;
  isolation: auto !important;
  transform: none !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}

/* ========================================
   🚨 Dialog内容强制可见
   ======================================== */

/* 确保Dialog内所有内容可见 - 仅快速引用 */
[role="dialog"].quick-reference-dialog *,
[role="dialog"][class*="quick-reference"] *,
.quick-reference-dialog[role="dialog"] *,
[role="dialog"]:has([class*="quick-reference"]) * {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  color: inherit !important;
  background: transparent !important;
  border: none !important;
  margin: 5px !important;
  padding: 5px !important;
}

/* 保持flex布局 - 仅快速引用 */
[role="dialog"].quick-reference-dialog .flex,
[role="dialog"][class*="quick-reference"] .flex,
.quick-reference-dialog[role="dialog"] .flex,
[role="dialog"]:has([class*="quick-reference"]) .flex,
[role="dialog"].quick-reference-dialog [class*="flex"],
[role="dialog"][class*="quick-reference"] [class*="flex"],
.quick-reference-dialog[role="dialog"] [class*="flex"],
[role="dialog"]:has([class*="quick-reference"]) [class*="flex"] {
  display: flex !important;
}

/* ========================================
   🚨 背景遮罩修复
   ======================================== */

/* 确保背景遮罩可见 - 仅快速引用相关 */
[data-radix-portal]:has([role="dialog"].quick-reference-dialog) [data-radix-dialog-overlay],
[data-radix-portal]:has([class*="quick-reference"]) [data-radix-dialog-overlay] {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  z-index: 999997 !important;
  background-color: rgba(255, 0, 0, 0.3) !important;
  backdrop-filter: blur(2px) !important;
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}

/* ========================================
   🚨 调试标识
   ======================================== */

/* 添加调试标识确保CSS生效 - 仅快速引用 */
[role="dialog"].quick-reference-dialog::before,
[role="dialog"][class*="quick-reference"]::before,
.quick-reference-dialog[role="dialog"]::before,
[role="dialog"]:has([class*="quick-reference"])::before {
  content: "🚨 DIALOG OVERRIDE ACTIVE" !important;
  position: absolute !important;
  top: -40px !important;
  left: 0 !important;
  background: #ff0000 !important;
  color: #ffffff !important;
  padding: 8px 12px !important;
  font-size: 14px !important;
  font-weight: bold !important;
  border-radius: 4px !important;
  z-index: 999999 !important;
  white-space: nowrap !important;
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
}

/* ========================================
   🚨 移动端适配
   ======================================== */

@media (max-width: 640px) {
  [role="dialog"].quick-reference-dialog,
  [role="dialog"][class*="quick-reference"],
  .quick-reference-dialog[role="dialog"],
  [role="dialog"]:has([class*="quick-reference"]) {
    max-width: calc(95vw - 20px) !important;
    max-height: calc(90vh - 20px) !important;
    min-width: 280px !important;
    padding: 16px !important;
  }
}

/* ========================================
   🚨 性能优化
   ======================================== */

html body * [role="dialog"],
html body [role="dialog"],
html [role="dialog"],
body [role="dialog"],
[role="dialog"] {
  will-change: auto !important;
  backface-visibility: visible !important;
  transform-style: flat !important;
}